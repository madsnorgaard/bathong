{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/forms/**",
              "components/media/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo Black|Space Grotesk|Space Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo Black, Space Grotesk, Space Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|disabled|children|onClick|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, disabled, children, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|signal|ghost)$/]",
        "message": "<Button> variant must be one of 'solid' | 'signal' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DictionaryCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:entry|pos|senses|surface|style|key|ref|className|style|children)$/]",
        "message": "<DictionaryCard> doesn't accept that prop. Declared props: entry, pos, senses, surface, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DictionaryCard'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:ink|paper)$/]",
        "message": "<DictionaryCard> surface must be one of 'ink' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EssayFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|ratio|credit|key|ref|className|style|children)$/]",
        "message": "<EssayFrame> doesn't accept that prop. Declared props: src, ratio, credit."
      },
      {
        "selector": "JSXOpeningElement[name.name='EssayFrame'] > JSXAttribute[name.name='ratio'] > Literal[value!=/^(?:3\\/2|4\\/5|1\\/1)$/]",
        "message": "<EssayFrame> ratio must be one of '3/2' | '4/5' | '1/1'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|as|rows|placeholder|type|name|required|value|onChange|className|id|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, as, rows, placeholder, type, name, required, value, onChange, className, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|textarea)$/]",
        "message": "<Field> as must be one of 'input' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Frame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|tag|label|credit|className|style|children|key|ref|className|style|children)$/]",
        "message": "<Frame> doesn't accept that prop. Declared props: src, alt, ratio, tag, label, credit, className, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Frame'] > JSXAttribute[name.name='ratio'] > Literal[value!=/^(?:3\\/2|21\\/9|4\\/5|1\\/1)$/]",
        "message": "<Frame> ratio must be one of '3/2' | '21/9' | '4/5' | '1/1'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:chip|children|className|key|ref|className|style|children)$/]",
        "message": "<Kicker> doesn't accept that prop. Declared props: chip, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='MemberCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|price|priceNote|cta|ctaHref|footnote|className|style|key|ref|className|style|children)$/]",
        "message": "<MemberCard> doesn't accept that prop. Declared props: number, price, priceNote, cta, ctaHref, footnote, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PunchDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|color|style|key|ref|className|style|children)$/]",
        "message": "<PunchDot> doesn't accept that prop. Declared props: size, variant, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PunchDot'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:dot|avatar)$/]",
        "message": "<PunchDot> variant must be one of 'dot' | 'avatar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RuledListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:num|label|note|key|ref|className|style|children)$/]",
        "message": "<RuledListItem> doesn't accept that prop. Declared props: num, label, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|index|dotColor|level|className|key|ref|className|style|children)$/]",
        "message": "<SectionHead> doesn't accept that prop. Declared props: title, index, dotColor, level, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|className|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: variant, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:signal|ink|outline)$/]",
        "message": "<Tag> variant must be one of 'signal' | 'ink' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ticker'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|speed|style|key|ref|className|style|children)$/]",
        "message": "<Ticker> doesn't accept that prop. Declared props: items, speed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|as|href|dotColor|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, as, href, dotColor, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:span|h1|h2|div)$/]",
        "message": "<Wordmark> as must be one of 'span' | 'h1' | 'h2' | 'div'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
