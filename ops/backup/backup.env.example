# Settings for ops/backup/pull.sh and restore-drill.sh on the backup host.
# Copy to /etc/bathong-backup.env, chmod 600, and fill in. Nothing here
# belongs in git: this file is an example with placeholders only.

# The SSH destination for production, as the backup host reaches it. Best an
# alias in the backup user's ~/.ssh/config that names the host, the port, the
# user and the dedicated key (IdentityFile, IdentitiesOnly yes).
BACKUP_SOURCE=bathong-production

# Where the mirror and the state live on the backup host.
BACKUP_DIR=/var/lib/bathong-backup

# The restic repository and its password file (chmod 600). Create the
# repository once with: restic init
RESTIC_REPOSITORY=/var/lib/bathong-backup/restic
RESTIC_PASSWORD_FILE=/etc/bathong-backup.pass

# Retention. A night that looks wrong is kept but never thins the history.
KEEP_DAILY=30
KEEP_MONTHLY=12

# Optional dead man's switch: a URL that is fetched when a run succeeds, and
# with /fail appended when it fails (the healthchecks.io convention). Leave
# empty to rely on systemd alone.
HEARTBEAT_URL=

# The same for the monthly restore drill, if it should have its own check.
DRILL_HEARTBEAT_URL=
