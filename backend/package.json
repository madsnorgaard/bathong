{
  "name": "bathong-backend",
  "version": "1.0.0",
  "description": "Payload CMS v3 backend for the Bathong. collective platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "payload": "payload",
    "seed": "tsx --env-file-if-exists=.env src/seed/seed.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.84.1",
    "@payloadcms/email-nodemailer": "^3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "graphql": "^16.9.0",
    "next": "16.2.6",
    "payload": "3.84.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.11",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
