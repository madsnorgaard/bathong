# Payload backend - local development
DATABASE_URI=postgresql://bathong:change-me@localhost:5432/bathong
PAYLOAD_SECRET=generate-a-long-random-string
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
MEDIA_DIR=
# Cross-subdomain auth cookies (frontend + api share a parent domain).
# Leave unset in dev; in production set e.g. COOKIE_DOMAIN=.example.org
COOKIE_DOMAIN=
# The site origin for the links in mail (verify, reset, membership). In
# production docker-compose.yml passes https://$SITE_DOMAIN; left empty here
# it falls back to the first CORS origin.
SITE_URL=

# Test-only endpoints (GET /api/e2e/*, admin-only) that read the tokens which
# otherwise travel by email. Set in CI and on a dev backend; never in production.
E2E_HOOKS=

# SMTP for account emails (verification, password reset, membership). Leave
# SMTP_HOST unset in dev - Payload logs emails to the console instead of
# sending. Production: the collective's mail server, authenticated as the
# noreply account.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=noreply@bathong.africa
SMTP_PASS=
SMTP_FROM=noreply@bathong.africa
