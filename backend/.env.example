# Payload backend - local development
DATABASE_URI=postgresql://bathong:change-me@localhost:5432/bathong
PAYLOAD_SECRET=generate-a-long-random-string
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
MEDIA_DIR=
# Cross-subdomain auth cookies (frontend + api share a parent domain).
# Leave unset in dev; in production set e.g. COOKIE_DOMAIN=.example.org
COOKIE_DOMAIN=
# Where password-reset links point (the site). Defaults to the first CORS origin.
SITE_URL=

# SMTP for auth emails (password reset now, verification when self-signup
# opens). Leave SMTP_HOST unset in dev - Payload logs emails to the console
# instead of sending. Production: the collective's mail server, authenticated
# as the noreply account.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=noreply@bathong.africa
SMTP_PASS=
SMTP_FROM=noreply@bathong.africa
